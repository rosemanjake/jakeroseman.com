---
interface Props {
  section?: string;
  tagline?: string;
}

const { section, tagline } = Astro.props;

const isHome = Astro.url.pathname === "/";

const tabs = [
  { label: "Writing", href: "/writing/" },
  { label: "Photography", href: "/photography/" },
  { label: "Projects", href: "/projects/" },
  { label: "About", href: "/about/" },
];
---

<header class="site">
  <p class="masthead">
    {isHome ? <span>Jake Roseman</span> : <a href="/">Jake Roseman</a>}
  </p>
  <p class="section-name">{tagline ?? section}</p>
  <nav class="site-nav">
    {
      tabs.map((tab) => (
        <a href={tab.href} aria-current={tab.label === section ? "page" : undefined}>
          {tab.label}
        </a>
      ))
    }
  </nav>
</header>
