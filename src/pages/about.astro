---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import headshot from "../assets/headshot.jpg";
---

<Base
  title="About — Jake Roseman"
  description="Software engineer from Australia, living in London."
>
  <Header section="About" />
  <main class="about">
    <Image class="portrait" src={headshot} width={360} alt="Jake Roseman" />
    <div class="about-text">
      <p>
        I am an Australian software developer in England, where I work for
        Google as a technical writer.
      </p>

      <p>
        I take pride in writing clean, efficient, and maintainable code that
        solves complex problems. I dabble in short fiction, hiking, and <a
          href="/photography/">photography</a
        >.
      </p>

      <dl class="skills">
        <div>
          <dt>Languages</dt>
          <dd>TypeScript, JavaScript, Kotlin, C#, Python, Java</dd>
        </div>
        <div>
          <dt>Web</dt>
          <dd>React, Next.js, Node, Firebase, CSS</dd>
        </div>
        <div>
          <dt>Mobile</dt>
          <dd>Android, Jetpack Compose</dd>
        </div>
        <div>
          <dt>Working&nbsp;knowledge</dt>
          <dd>C++, SQL, Flask, Go</dd>
        </div>
      </dl>

      <ul class="contact-list">
        <li><a href="/resume.pdf">Resume</a></li>
        <li>
          <a href="mailto:roseman.jake@gmail.com">roseman.jake@gmail.com</a>
        </li>
        <li><a href="https://github.com/rosemanjake">GitHub</a></li>
        <li><a href="https://www.linkedin.com/in/jake-roseman">LinkedIn</a></li>
      </ul>
    </div>
  </main>
</Base>
