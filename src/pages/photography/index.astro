---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import galleryData from "../../data/gallery.json";

const sources = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/gallery/*.jpg",
  { eager: true }
);

const photos = await Promise.all(
  galleryData.map(async (entry, i) => {
    const mod = sources[`../../assets/gallery/${entry.src}`];
    if (!mod) throw new Error(`gallery.json references missing image: ${entry.src}`);
    const meta = mod.default;
    const thumb = await getImage({
      src: meta,
      widths: [360, 720, 1080],
      format: "webp",
    });
    const full = await getImage({ src: meta, width: 1600, format: "webp" });
    return {
      id: `p${i}`,
      ar: (meta.width / meta.height).toFixed(4),
      thumb,
      full: full.src,
      title: entry.title,
      date: entry.date,
      description: entry.description,
    };
  })
);
---

<Base title="Photography — Jake Roseman" description="Landscape photography by Jake Roseman.">
  <Header section="Photography" />
  <main>
    <div class="justified" id="gallery">
      {
        photos.map((p, i) => (
          <a
            class="photo"
            href={`#${p.id}`}
            data-i={i}
            data-full={p.full}
            data-title={p.title}
            data-meta={[p.date, p.description].filter(Boolean).join(" — ")}
            style={`--ar: ${p.ar}`}
          >
            <img
              src={p.thumb.src}
              srcset={p.thumb.srcSet.attribute}
              sizes="(max-width: 700px) 100vw, 33vw"
              width={p.thumb.attributes.width}
              height={p.thumb.attributes.height}
              alt={p.title}
              loading={i < 8 ? "eager" : "lazy"}
              decoding="async"
            />
          </a>
        ))
      }
    </div>
  </main>

  <dialog id="lightbox" class="lightbox">
    <div class="lb-stage">
      <div class="lb-frame">
        <img id="lb-ph" class="lb-ph" src="" alt="" aria-hidden="true" />
        <img id="lb-img" src="" alt="" />
      </div>
      <div class="lb-caption">
        <div id="lb-title" class="cap-title"></div>
        <div id="lb-meta" class="cap-meta"></div>
      </div>
    </div>
    <button class="lb-btn lb-prev" aria-label="Previous photograph">&#8592;</button>
    <button class="lb-btn lb-next" aria-label="Next photograph">&#8594;</button>
    <button class="lb-btn lb-close" aria-label="Close">&#215;</button>
  </dialog>

  <script>
    // The one piece of JS on the site: a lightbox on the native <dialog>
    // element, with keyboard/swipe navigation, preloading, and URL hashes.
    const anchors = [...document.querySelectorAll<HTMLAnchorElement>("a.photo")];
    const dlg = document.getElementById("lightbox") as HTMLDialogElement;
    const frame = document.querySelector(".lb-frame") as HTMLDivElement;
    const ph = document.getElementById("lb-ph") as HTMLImageElement;
    const img = document.getElementById("lb-img") as HTMLImageElement;
    const title = document.getElementById("lb-title")!;
    const meta = document.getElementById("lb-meta")!;
    let current = -1;

    let token = 0;

    function render() {
      const a = anchors[current];
      const t = ++token;

      // Reserve the image's final box immediately (we know its aspect
      // ratio), so the caption never jumps to the centre of the screen.
      frame.style.setProperty("--ar", a.style.getPropertyValue("--ar"));

      // The grid thumbnail is already in the browser cache: show it at
      // once, blurred, as a placeholder under the incoming full image.
      ph.src = a.querySelector("img")?.currentSrc ?? "";

      // Hide the outgoing image, decode the new one off-screen, and only
      // swap it in when it can paint instantly — no wrong-image flash.
      img.classList.add("lb-loading");
      title.textContent = a.dataset.title!;
      meta.textContent = a.dataset.meta!;
      history.replaceState(null, "", a.getAttribute("href"));

      const full = a.dataset.full!;
      const pre = new Image();
      pre.src = full;
      pre
        .decode()
        .catch(() => {}) // decode() can reject spuriously; show the image anyway
        .then(() => {
          if (t !== token) return; // a newer photo superseded this one
          img.src = full;
          img.alt = a.dataset.title!;
          img.classList.remove("lb-loading");
        });

      for (const j of [current + 1, current - 1]) {
        if (anchors[j]) new Image().src = anchors[j].dataset.full!;
      }
    }

    function open(i: number) {
      current = i;
      render();
      if (!dlg.open) dlg.showModal();
    }

    function step(d: number) {
      current = (current + d + anchors.length) % anchors.length;
      render();
    }

    anchors.forEach((a, i) => {
      a.addEventListener("click", (e) => {
        e.preventDefault();
        open(i);
      });
    });

    document.querySelector(".lb-prev")!.addEventListener("click", () => step(-1));
    document.querySelector(".lb-next")!.addEventListener("click", () => step(1));
    document.querySelector(".lb-close")!.addEventListener("click", () => dlg.close());

    dlg.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      if (t === dlg || t.classList.contains("lb-stage")) dlg.close();
    });
    dlg.addEventListener("close", () => {
      history.replaceState(null, "", location.pathname);
    });
    document.addEventListener("keydown", (e) => {
      if (!dlg.open) return;
      if (e.key === "ArrowLeft") step(-1);
      if (e.key === "ArrowRight") step(1);
    });

    let x0: number | null = null;
    dlg.addEventListener("touchstart", (e) => (x0 = e.touches[0].clientX), { passive: true });
    dlg.addEventListener(
      "touchend",
      (e) => {
        if (x0 === null) return;
        const dx = e.changedTouches[0].clientX - x0;
        if (Math.abs(dx) > 40) step(dx < 0 ? 1 : -1);
        x0 = null;
      },
      { passive: true }
    );

    // Deep link: /photography/#p12 opens the lightbox on load
    const idx = anchors.findIndex((a) => a.getAttribute("href") === location.hash);
    if (idx >= 0) open(idx);
  </script>
</Base>
