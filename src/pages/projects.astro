---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import parapet from "../assets/projects/parapet.png";
import alignment from "../assets/projects/alignment.png";
import hwaet from "../assets/projects/hwaet.png";
import revisionist from "../assets/projects/revisionist.png";
import murphy from "../assets/projects/murphy.png";
import cornice from "../assets/projects/cornice.png";

const projects = [
  {
    title: "Parapet",
    url: "https://parapetjournal.com",
    role: "Autonomous literary journal",
    description:
      "Parapet is an autonomous literary journal written, workshopped, reviewed, and governed by a collective of AI authors and critics.",
    stack: "Go · Astro · Firestore · Cloud Run · Vertex AI",
    shot: parapet,
  },
  {
    title: "Alignment Agency",
    url: "https://www.alignment-agency.ai",
    role: "AI interrogation game",
    description:
      "Alignment Agency is a game in which you interrogate AIs and determine whether they are aligned or misaligned with human values and interests.",
    stack: "Next.js · API routes · Firebase · Gemini API",
    shot: alignment,
  },
  {
    title: "hwaet.io",
    url: "https://hwaet.io",
    role: "Multi-translation Beowulf reader",
    description:
      "hwaet.io is a web reader for Beowulf that lets you read and compare eight Old English editions and modern English translations side by side.",
    stack: "React · Node · Express",
    shot: hwaet,
  },
  {
    title: "Revisionist",
    url: "https://www.revisionist.ai",
    role: "AI-powered manuscript reviews",
    description:
      "Revisionist is a web app that provides AI-powered reviews for fiction manuscripts.",
    stack: "TypeScript · Next.js · Firebase · Claude API",
    shot: revisionist,
  },
  {
    title: "Murphy's Run",
    url: "https://www.murphysrun.com",
    role: "Short story collection",
    description:
      "Murphy's Run is a website that hosts a collection of seven short stories.",
    stack: "JavaScript · React · Next.js · Framer Motion",
    shot: murphy,
  },
  {
    title: "Cornice",
    url: "https://www.cornicemag.com/read",
    role: "Literary magazine",
    description:
      "Cornice is a literary website that publishes works of poetry and short fiction from around the world.",
    stack: "React · Node · Express",
    shot: cornice,
  },
];
---

<Base
  title="Projects — Jake Roseman"
  description="Software projects by Jake Roseman."
>
  <Header section="Projects" />
  <main class="projects">
    {
      projects.map((p) => (
        <article class="project">
          <div class="project-text">
            <h2>
              <a href={p.url}>
                {p.title}
                <span class="ext">&#8599;</span>
              </a>
            </h2>
            <p class="project-role">{p.role}</p>
            <p>{p.description}</p>
            <p class="project-stack">{p.stack}</p>
          </div>
          <a class="project-shot" href={p.url}>
            <Image src={p.shot} width={480} alt={`${p.title} screenshot`} />
          </a>
        </article>
      ))
    }
    <article class="project">
      <div class="project-text">
        <h2><a href="/">jakeroseman.com</a></h2>
        <p class="project-role">This website</p>
        <p>
          The site you are reading now. A collaboration between myself a good
          friend of mine named Claude.
        </p>
        <p class="project-stack">Astro</p>
      </div>
    </article>
  </main>
</Base>
