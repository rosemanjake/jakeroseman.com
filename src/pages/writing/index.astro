---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";

const posts = await getCollection("writing");
const byDate = (a: (typeof posts)[number], b: (typeof posts)[number]) =>
  b.data.date.getTime() - a.data.date.getTime();
const sections = [
  { label: "Fiction", posts: posts.filter((p) => p.data.category === "fiction").sort(byDate) },
  { label: "Technical", posts: posts.filter((p) => p.data.category === "tech").sort(byDate) },
];

const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { month: "long", year: "numeric" });
---

<Base title="Writing — Jake Roseman" description="Short fiction and technical writing by Jake Roseman.">
  <Header section="Writing" />
  <main class="blog-index">
    {
      sections.map((section) => (
        <>
          <h2 class="section-label">{section.label}</h2>
          <div class="writing-gallery">
            {section.posts.map((post) => (
              <a class="writing-item" href={`/writing/${post.id}/`}>
                <Image
                  src={post.data.cover}
                  widths={[300, 460, 690]}
                  sizes="(max-width: 500px) 90vw, 300px"
                  alt=""
                />
                <span class="post-title">{post.data.title}</span>
                <span class="post-date">{fmt(post.data.date)}</span>
                <span class="post-sub">{post.data.subtitle}</span>
              </a>
            ))}
          </div>
        </>
      ))
    }
  </main>
</Base>
